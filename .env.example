# Copia a .env (lo hace «npm run setup»). .env nunca se sube al repositorio.

# --- Servidor ---
# Clave maestra AES-256 en base64 (32 bytes) para cifrar las claves de proveedores.
OIA_MASTER_KEY=
FIREBASE_PROJECT_ID=
# Correos (verificados) con acceso. Separados por comas.
OWNER_EMAILS=
# UIDs de Firebase permitidos (alternativa a OWNER_EMAILS)
OWNER_UIDS=
# Orígenes web permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8787
# Opcional: claves como variables de entorno en lugar del asistente
# OIA_KEY_GEMINI=
# OIA_KEY_GITHUB=
# Proveedores no gratuitos autorizados cuando la clave viene del entorno (p. ej. perplexity,openai)
# OIA_ALLOW_PAID=
# Solo desarrollo: proveedor simulado y token local
# OIA_ENABLE_MOCK=1
# OIA_DEV_TOKEN=

# --- Interfaz (públicos: se incluyen en el JavaScript del navegador) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# URL del servidor si está en otro dominio (p. ej. https://oia-api.<tu-subdominio>.workers.dev)
VITE_API_BASE=
# Solo desarrollo sin Firebase (debe coincidir con OIA_DEV_TOKEN)
# VITE_DEV_TOKEN=
